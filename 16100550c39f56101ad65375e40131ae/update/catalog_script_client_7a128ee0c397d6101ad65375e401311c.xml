        <name>Validate Refund Date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }
    var dateParts = newValue.split("/");
    var day = parseInt(dateParts[0]);
    var month = parseInt(dateParts[1]);
    var year = parseInt(dateParts[2]);

    var inputDateTime = new Date(year, month - 1, day);
    var currentDate = new Date();
    var differenceInMilliseconds = currentDate - inputDateTime;
    var millisecondsIn24Hours = 24 * 60 * 60 * 1000;

    if (differenceInMilliseconds < millisecondsIn24Hours) {
        g_form.addErrorMessage("Error: The payment date must be at least 24 hours before the current date.");
		g_form.clearValue("payment_date");
    }
}]]></script>
